{
  "name": "timeful",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Self-hosted group availability scheduling app",
  "license": "MIT",
  "author": "Yuxuan Zhang, web-dev@z-yx.cc",
  "homepage": "https://github.com/zhangyx1998/timeful#readme",
  "bugs": {
    "url": "https://github.com/zhangyx1998/timeful/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyx1998/timeful.git"
  },
  "keywords": [
    "scheduling",
    "availability",
    "calendar",
    "self-hosted",
    "meeting",
    "poll",
    "when2meet"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "prebuild": "rm -rf dist",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run build:cli",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:cli": "rollup --config rollup.config.ts --configPlugin esbuild",
    "build:debug": "rollup --config rollup.config.ts --configPlugin esbuild --configDebug",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@zhangyx1998/svg-loader": "^0.0.2",
    "dayjs": "^1.11.21",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "rollup": "^4.62.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.10",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
